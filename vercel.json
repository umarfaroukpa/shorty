{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        }
    ],
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/next",
            "config": {
                "installCommand": "npm install && npm run build"
            }
        }
    ]
}